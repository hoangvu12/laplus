node_modules/
*.log
*.tsbuildinfo
.DS_Store
.idea/

apps/*/dist
packages/*/dist
.vite-plus/
.tanstack
.vitest-*
__screenshots__/

# The Cargo workspace root is server/, so its build directory is there too.
server/target/

.env*
!.env.example

# Unredacted proxy recordings from server/tools/wire-capture. These hold live
# session tokens, and this repository is public. The redacted, committable
# versions live in server/fixtures/socket-wire/ — see
# server/docs/socket-wire-format.md. Everything else under .scratch/ is tracker
# content and is committed on purpose.
.scratch/wire-capture/raw/

# One run's worth of socket frames from server/tools/ui-driver/repro.mjs,
# rewritten every run. Output rather than evidence, and a transcript of a live
# session.
server/tools/ui-driver/frames.log

# The updater's signing key, if anybody ever writes one here. It belongs in
# `~/.tauri/` and in the repository's `TAURI_SIGNING_PRIVATE_KEY` secret, and
# nowhere else: an installed laplus only accepts an update signed by the key
# whose public half is in `tauri.conf.json`, so this file leaking is somebody
# else able to publish an update to every install, and this file being lost is
# every install stranded. Ticket 74.
*.key
*.key.pub

# The updater manifest, written at the repository root by the release workflow
# from whatever the bundler just signed. An asset of a release rather than a
# file of this project — a committed one would be a stale copy that nothing
# reads and somebody eventually trusts. Ticket 74.
latest.json
