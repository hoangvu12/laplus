# Optional configuration for source builds. Every value here is public — release
# builds inject their own at build time. Do not put server-side secrets in this
# file; it is committed.
#
# laplus runs entirely locally by default. Nothing below is needed to build the
# application, run the server, or open the window. These switch on the optional
# hosted features the UI still carries.

# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth
# applications. Without them the sign-in surfaces stay inert.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# T3CODE_CLERK_JWT_TEMPLATE=t3-relay
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# The relay the environment-discovery UI points at. This repository does not
# deploy one — that was upstream's `infra/relay`, which laplus does not carry.
# T3CODE_RELAY_URL=https://relay.example.com

# Hosted app origin for the out-of-band OAuth flow.
# T3CODE_HOSTED_APP_URL=https://app.t3.codes

# The port `laplus-server` listens on. Defaults to 4773; `apps/web`'s dev server
# proxies to it, so change both or neither.
# LAPLUS_PORT=4773
